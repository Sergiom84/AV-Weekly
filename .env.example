# Configuracion opcional de base de datos.
# Sin estas variables, AV Weekly usa un fichero local: data/av-weekly.db

# URL de la base de datos. Acepta "file:./data/av-weekly.db" o una URL remota libSQL/Turso.
# URL_TURSO=

# Token de autenticacion. Solo necesario cuando URL_TURSO apunta a una base remota.
# TOKEN_TURSO=
